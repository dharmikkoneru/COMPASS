# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Local environment (contains your Supabase URL + anon key)
.env
.env.*
!.env.example

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Freebuff thread-local artifacts (preview logs, pid notes)
.freebuff/

# Python — the FastAPI service in backend/
__pycache__/
*.py[cod]
backend/.venv/
.pytest_cache/
.ruff_cache/
# `.env.*` above would swallow the backend template; it holds no secrets.
!backend/.env.example

# Supabase CLI state (written by `supabase login` / `link`) — per-machine.
supabase/.temp/
