# ── Supabase (Project Settings → API) ─────────────────────────
# Copy this file to `.env` and replace both values with your own project's.
#   cp .env.example .env
# The anon key is public by design (it ships in the browser bundle) but it is
# still per-project — replacing these placeholders is what makes the app talk
# to YOUR database instead of nobody's.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY

# ── Gemini (server-side only, NOT used by the Vite app) ───────
# Get a free key: https://aistudio.google.com/apikey
# It must be set as a Supabase Edge Function secret — the key is read inside
# the generate-quiz function and is never bundled into the frontend:
#   supabase secrets set GEMINI_API_KEY=your_key
# Never put the key in this file: anything prefixed VITE_ is embedded in the
# client bundle, and a stray GEMINI_API_KEY here is ignored by the app anyway.
