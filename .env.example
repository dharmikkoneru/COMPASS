# ── Supabase (Project Settings → API) ─────────────────────────
# Copy this file to `.env` and replace both values with your own project's.
#   cp .env.example .env
# The anon key is public by design (it ships in the browser bundle) but it is
# still per-project — replacing these placeholders is what makes the app talk
# to YOUR database instead of nobody's.
VITE_SUPABASE_URL=https://zkoetojjrgbvvgklltti.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Inprb2V0b2pqcmdidnZna2xsdHRpIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODg3OTMxODAsImV4cCI6MjEwNDM2OTE4MH0.z-FoMUBm47sv1eGOCiThD4VxTIcJ1lrJQUQqWrkXYWk

# ── FastAPI AI service (optional) ────────────────────────────
# Origin of the Python AI service in `backend/`, deployed on Render.
# Set it and the app sends quiz generation and RAG to FastAPI; leave it
# unset and the Supabase edge functions answer instead. With it set, an
# unreachable API (a Render cold start, for instance) still falls back to
# the edge functions so a demo cannot go dark.
VITE_API_BASE_URL=https://compass-api.onrender.com
# Set to `false` to disable that fallback while testing the API alone.
VITE_AI_FALLBACK=true

# ── Gemini (server-side only, NOT used by the Vite app) ───────
# Get a free key: https://aistudio.google.com/apikey
# It must be set as a Supabase Edge Function secret — the key is read inside
# the generate-quiz function and is never bundled into the frontend:
#   supabase secrets set GEMINI_API_KEY=your_key
# Never put the key in this file: anything prefixed VITE_ is embedded in the
# client bundle, and a stray GEMINI_API_KEY here is ignored by the app anyway.
