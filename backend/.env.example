# ── COMPASS API — local environment ───────────────────────────────
# Copy to `backend/.env` and fill in. On Render these are set in the
# dashboard instead; this file is for `uvicorn` on your own machine.
#   cp backend/.env.example backend/.env
#   cd backend && uvicorn app.main:app --reload --port 8000
#
# The service holds no service-role key on purpose: it forwards the officer's
# own access token to the database, so RLS decides what it may read and write.

# ── Supabase (Project Settings → API) ─────────────────────────────
# Same project the frontend uses (VITE_SUPABASE_URL in the root .env).
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# The anon/public key. It is public by design, and it is only used to address
# PostgREST — authorisation comes from the officer's token.
SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY

# ── Gemini (server-side only) ─────────────────────────────────────
# Same key that is already a Supabase edge-function secret:
#   supabase secrets set GEMINI_API_KEY=your_key
GEMINI_API_KEY=your_gemini_key

# ── Optional ──────────────────────────────────────────────────────
# CORS allow-list, comma separated. Add the Vercel deployment URL here once it
# exists; the Netlify URL stays listed so neither host breaks in the meantime.
# ALLOWED_ORIGINS=http://localhost:5173,https://compassprototype2026.netlify.app,https://your-app.vercel.app
# Width to request from the embedding model. Must match
# material_chunks.embedding (vector(768) in migration 0007).
# GEMINI_EMBED_DIMENSIONS=768
